---
const currentPath = Astro.url.pathname;

const navigationGroups = [
    {
        label: "Accueil",
        links: [{ id: "home", label: "Accueil", href: "/" }],
    },
    {
        label: "Manchots",
        links: [
            { id: "penguin-filtre", label: "Penguin avec filtre", href: "/penguin-filtre/" },
            { id: "penguin-filtres", label: "Penguin avec plusieurs filtres", href: "/penguin-filtres/" },
            { id: "graphique1", label: "Graphique 1", href: "/graphique1/" },
            { id: "graphique2", label: "Graphique 2", href: "/graphique2/" },
            { id: "graphique3", label: "Graphique 3", href: "/graphique3/" },
            { id: "graphique4", label: "Graphique 4", href: "/graphique4/" },
            { id: "species", label: "Tri par espèces", href: "/species/" },
            { id: "species-tabs", label: "Espèces par onglets", href: "/species-tabs/" },
            { id: "species-index", label: "Espèces (routes statiques)", href: "/penguins/specie/" },
            { id: "island-index", label: "Îles", href: "/penguins/island/" },
            { id: "sex-index", label: "Sexes", href: "/penguins/sex/" },
            { id: "adelie", label: "Adélie", href: "/species/Adelie/" },
            { id: "gentoo", label: "Gentoo", href: "/species/Gentoo/" },
            { id: "chinstrap", label: "Chinstrap", href: "/species/Chinstrap/" },
        ],
    },
    {
        label: "Autres datasets",
        links: [
            { id: "pokemon", label: "Pokémon", href: "/pokemon/" },
            { id: "pokemon-filtre", label: "Pokémon avec filtre", href: "/pokemon-filtre/" },
            { id: "planets", label: "Planètes", href: "/planets/" },
            { id: "planets-filtre", label: "Planètes avec filtre", href: "/planets-filtre/" },
            { id: "cars", label: "Voitures", href: "/cars/" },
        ],
    },
];
---

<nav class="sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur-xl" aria-label="Navigation principale">
    <div class="mx-auto flex min-h-[4.5rem] w-[min(100%-2rem,75rem)] items-center justify-end gap-4 max-[42rem]:flex-wrap max-[42rem]:gap-2 max-[42rem]:py-3">
        <label class="text-sm font-bold text-slate-500" for="page-navigation">Aller à une page</label>
        <select class="min-w-52 cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 focus:outline-3 focus:outline-amber-600 max-[42rem]:min-w-0 max-[42rem]:flex-1" id="page-navigation" aria-label="Choisir une page">
            {navigationGroups.map((group) => (
                <optgroup label={group.label}>
                    {group.links.map((tab) => (
                        <option value={tab.href} selected={tab.href === currentPath}>{tab.label}</option>
                    ))}
                </optgroup>
            ))}
        </select>
    </div>
</nav>

<script>
    document.querySelector("#page-navigation")?.addEventListener("change", (event) => {
        window.location.pathname = (event.target as HTMLSelectElement).value;
    });
</script>
