---
import penguins from "../data/penguins.json";
import Layout from "../layouts/Layout.astro";

const speciesList = [...new Set(penguins.map((penguin) => penguin.species))];
const islandList = [...new Set(penguins.map((penguin) => penguin.island))];
const sexList = [
    ...new Set(
        penguins
            .map((penguin) => penguin.sex)
            .filter((sex): sex is string => sex != null),
    ),
];
---

<Layout title="Penguin avec plusieurs filtres - Observable Plot">
    <main class="ml-40 mt-10">
        <h1>Penguin avec plusieurs filtres</h1>
        <div class="mb-5 grid grid-cols-1 gap-3 rounded-xl border border-slate-200 bg-white/70 p-4 md:grid-cols-3 md:gap-4">
            <label class="grid gap-1.5 text-sm font-bold text-slate-600" for="species">
                Espèce
                <select class="min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal text-slate-900 focus:outline-3 focus:outline-amber-600" name="species" id="species">
                    <option value="">All species</option>
                    {speciesList.map((species) => <option value={species}>{species}</option>)}
                </select>
            </label>
            <label class="grid gap-1.5 text-sm font-bold text-slate-600" for="island">
                Île
                <select class="min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal text-slate-900 focus:outline-3 focus:outline-amber-600" name="island" id="island">
                    <option value="">All islands</option>
                    {islandList.map((island) => <option value={island}>{island}</option>)}
                </select>
            </label>
            <label class="grid gap-1.5 text-sm font-bold text-slate-600" for="sex">
                Sexe
                <select class="min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal text-slate-900 focus:outline-3 focus:outline-amber-600" name="sex" id="sex">
                    <option value="">All sexes</option>
                    {sexList.map((sex) => <option value={sex}>{sex}</option>)}
                </select>
            </label>
        </div>
        <div id="plot" class="plot-shell" aria-live="polite"></div>
        <p class="mt-8"><a href="/">← Retour au sommaire</a></p>
    </main>
</Layout>

<script>
    import * as Plot from "@observablehq/plot";
    import penguins from "../data/penguins.json";

    const selectSpecies = document.querySelector<HTMLSelectElement>("#species");
    const selectIsland = document.querySelector<HTMLSelectElement>("#island");
    const selectSex = document.querySelector<HTMLSelectElement>("#sex");

    function renderPlot() {
        const species = selectSpecies?.value ?? "";
        const island = selectIsland?.value ?? "";
        const sex = selectSex?.value ?? "";
        const plotContainer = document.querySelector<HTMLDivElement>("#plot");
        if (!plotContainer) return;
        const filteredPenguins = penguins.filter(
            (penguin) =>
                (!species || penguin.species === species) &&
                (!island || penguin.island === island) &&
                (!sex || penguin.sex === sex),
        );
        plotContainer.replaceChildren();
        const plot = Plot.plot({
            title: "Morphologie du bec des manchots filtrés",
            grid: true,
            color: { legend: true },
            marks: [
                Plot.dot(filteredPenguins, {
                    x: "culmen_length_mm",
                    y: "culmen_depth_mm",
                    stroke: "species",
                }),
            ],
        });
        plotContainer.append(plot);
    }

    [selectSpecies, selectIsland, selectSex].forEach((select) =>
        select?.addEventListener("change", renderPlot),
    );
    renderPlot();
</script>
