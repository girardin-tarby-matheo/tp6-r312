---
import * as Plot from "@observablehq/plot";
import Layout from "../layouts/Layout.astro";
import PlotFigure from "../components/PlotFigure.astro";
import rawPenguins from "../data/penguins.json";

const penguins = rawPenguins.filter((d) => d.flipper_length_mm);
const options = {
    title: "Longueur des nageoires par espèce",
    subtitle: "Médianes, quartiles et valeurs extrêmes (en mm)",
    height: 300,
    marginLeft: 100,
    grid: true,
    marks: [
        Plot.boxX(penguins, {
            x: "flipper_length_mm",
            y: "species",
            fill: "species",
        }),
    ],
};
---

<Layout title="Graphique 4 - Manchots de Palmer">
    <main class="ml-40 mt-10">
        <PlotFigure options={options} />
        <p class="mt-8">
            <a href="/" class="text-blue-600 hover:underline"
                >← Retour à l'accueil</a
            >
        </p>
    </main>
</Layout>
