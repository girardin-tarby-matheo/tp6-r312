---
import * as Plot from "@observablehq/plot";
import rawPenguins from "../../../data/penguins.json";
import Layout from "../../../layouts/Layout.astro";
import PlotFigure from "../../../components/PlotFigure.astro";

export function getStaticPaths() {
    const islandList = [
        ...new Set(
            rawPenguins
                .map((penguin) => penguin.island)
                .filter((island): island is string => island != null),
        ),
    ];

    return islandList.map((island) => ({
        params: { island },
    }));
}

const { island } = Astro.params;
const filteredPenguins = rawPenguins.filter(
    (penguin) =>
        penguin.island === island &&
        penguin.culmen_length_mm != null &&
        penguin.culmen_depth_mm != null,
);

const plotOptions = {
    title: `Manchots de l'île ${island} — Morphologie du bec`,
    subtitle: "Relation entre la longueur et la profondeur du bec (en mm)",
    grid: true,
    color: { legend: true },
    marks: [
        Plot.dot(filteredPenguins, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
        }),
    ],
};
---

<Layout title={`Île ${island} — Manchots de Palmer`}>
    <main class="ml-40 mt-10">
        <h1>Manchots de l'île {island}</h1>
        <p>{filteredPenguins.length} individu(s) trouvé(s).</p>
        <PlotFigure options={plotOptions} />
    </main>
</Layout>
