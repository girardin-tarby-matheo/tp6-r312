---
import * as Plot from "@observablehq/plot";
import rawPenguins from "../../../data/penguins.json";
import Layout from "../../../layouts/Layout.astro";
import PlotFigure from "../../../components/PlotFigure.astro";

export function getStaticPaths() {
    const speciesList = [...new Set(rawPenguins.map((penguin) => penguin.species))];

    return speciesList.map((species) => ({
        params: { species },
    }));
}

const { species } = Astro.params;
const penguinsSpecies = rawPenguins.filter(
    (penguin) =>
        penguin.species === species &&
        penguin.culmen_length_mm != null &&
        penguin.culmen_depth_mm != null,
);

const plotOptions = {
    title: `Manchots ${species} — Morphologie du bec`,
    subtitle: "Relation entre la longueur et la profondeur du bec (en mm)",
    grid: true,
    color: { legend: true },
    marks: [
        Plot.dot(penguinsSpecies, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "island",
        }),
    ],
};
---

<Layout title={`Espèce ${species} — Manchots de Palmer`}>
    <main class="ml-40 mt-10">
        <h1>Manchots {species}</h1>
        <p>
            Cette page affiche {penguinsSpecies.length} individu(s) de
            l'espèce {species}.
        </p>
        <PlotFigure options={plotOptions} />
    </main>
</Layout>
