---
import pokemon from "../data/pokemon.json";
import Layout from "../layouts/Layout.astro";

const pokemonTypes = [...new Set(pokemon.map((item) => item.type1))].sort();
const generations = [...new Set(pokemon.map((item) => item.generation))].sort(
    (first, second) => first - second,
);
---

<Layout title="Pokémon avec filtre - Observable Plot">
    <main class="ml-40 mt-10 max-w-5xl pr-8 pb-16">
        <h1>Pokémon avec filtre</h1>
        <div class="mb-5 grid grid-cols-1 gap-3 rounded-xl border border-slate-200 bg-white/70 p-4 md:grid-cols-3 md:gap-4">
            <label class="grid gap-1.5 text-sm font-bold text-slate-600" for="type1">
                Type principal
                <select class="min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal text-slate-900 focus:outline-3 focus:outline-amber-600" name="type1" id="type1">
                    <option value="">Tous les types</option>
                    {pokemonTypes.map((type) => <option value={type}>{type}</option>)}
                </select>
            </label>
            <label class="grid gap-1.5 text-sm font-bold text-slate-600" for="generation">
                Génération
                <select class="min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal text-slate-900 focus:outline-3 focus:outline-amber-600" name="generation" id="generation">
                    <option value="">Toutes les générations</option>
                    {generations.map((generation) => (
                        <option value={generation}>Génération {generation}</option>
                    ))}
                </select>
            </label>
            <label class="grid gap-1.5 text-sm font-bold text-slate-600" for="legendary">
                Statut
                <select class="min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal text-slate-900 focus:outline-3 focus:outline-amber-600" name="legendary" id="legendary">
                    <option value="">Tous</option>
                    <option value="true">Légendaires</option>
                    <option value="false">Non légendaires</option>
                </select>
            </label>
        </div>
        <div id="pokemon-plot" class="plot-shell" aria-live="polite"></div>
        <p class="mt-8"><a href="/">← Retour au sommaire</a></p>
    </main>
</Layout>

<script>
    import * as Plot from "@observablehq/plot";
    import pokemon from "../data/pokemon.json";

    const typeSelect = document.querySelector<HTMLSelectElement>("#type1");
    const generationSelect =
        document.querySelector<HTMLSelectElement>("#generation");
    const legendarySelect =
        document.querySelector<HTMLSelectElement>("#legendary");
    const container = document.querySelector<HTMLDivElement>("#pokemon-plot");

    function renderPlot() {
        if (!container) return;
        const type = typeSelect?.value ?? "";
        const generation = generationSelect?.value ?? "";
        const legendary = legendarySelect?.value ?? "";
        const filteredPokemon = pokemon.filter(
            (item) =>
                (!type || item.type1 === type) &&
                (!generation || String(item.generation) === generation) &&
                (!legendary || String(item.legendary) === legendary),
        );
        const plot = Plot.plot({
            title: "Attaque et vitesse des Pokémon filtrés",
            subtitle: "Taille du point = PV, couleur = type principal",
            grid: true,
            inset: 10,
            color: { legend: true },
            marks: [
                Plot.dot(filteredPokemon, {
                    x: "speed",
                    y: "attack",
                    stroke: "type1",
                    r: (item) => Math.sqrt(item.hp) * 0.8,
                    title: "name",
                }),
            ],
        });
        container.replaceChildren(plot);
    }

    [typeSelect, generationSelect, legendarySelect].forEach((select) =>
        select?.addEventListener("change", renderPlot),
    );
    renderPlot();
</script>
