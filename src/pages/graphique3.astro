---
import * as Plot from "@observablehq/plot";
import Layout from "../layouts/Layout.astro";
import PlotFigure from "../components/PlotFigure.astro";
import rawPenguins from "../data/penguins.json";

const penguins = rawPenguins.filter((d) => d.sex);
const options = {
    title: "Effectif recensé par espèce et par sexe",
    subtitle: "Répartition globale de l'échantillon étudié",
    height: 300,
    marginLeft: 100,
    x: { grid: true },
    color: { legend: true },
    marks: [
        Plot.barX(
            penguins,
            Plot.groupY({ x: "count" }, { y: "species", fill: "sex" }),
        ),
        Plot.ruleX([0]),
    ],
};
---

<Layout title="Graphique 3 - Manchots de Palmer">
    <main class="ml-40 mt-10">
        <PlotFigure options={options} />
        <p class="mt-8">
            <a href="/" class="text-blue-600 hover:underline"
                >← Retour à l'accueil</a
            >
        </p>
    </main>
</Layout>
